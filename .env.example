# Copy to .env. Everything here is optional: the system runs without any of it.

# --- Gemini (the investigator, the verdict's explanation, the ticket, the looks) ---
# Preferred: Google Cloud's own login. Locally run `gcloud auth application-default
# login`; on Cloud Run the service account is used. The SDK reads these three.
GOOGLE_GENAI_USE_ENTERPRISE=
GOOGLE_CLOUD_LOCATION=global
# Or an API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Any current model id; agents/factory.py has the default. Every place that
# calls Gemini reads this one setting. Check them all with: hypengine gemini-check
GEMINI_MODEL=gemini-3.8-flash
# Two call sites may use a model of their own: the camera look (falls back to
# GEMINI_MODEL) and Lens, which boxes a machine with the robotics model.
GEMINI_VISION_MODEL=
GEMINI_LENS_MODEL=gemini-robotics-er-2-preview
# "off" keeps a model from writing the explanation beside a verdict. The verdict,
# the action and what would change it are the engine's own lines either way.
CRUX_REPORT_MODEL=
# Streaming coach (Gemini Robotics-ER 2). Preview; see docs/DECISIONS.md ADR-0005.
GEMINI_ROBOTICS_MODEL=gemini-robotics-er-2-streaming-preview

# --- Jev / TypeSafe (typed per-second decisions) ------------------------------
# https://typesafe.ai
TYPESAFE_API_KEY=

# --- Google Cloud (deploy, and the Gemini login above) -------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1

# --- Rig ----------------------------------------------------------------------
# The token the ESP32 posts with (firmware/esp32_rig). Empty turns POST /ingest
# and its sub-routes off, which is the safe setting for a public link.
RIG_INGEST_TOKEN=

# --- Data ---------------------------------------------------------------------
# Where datasets, derived tables and what the app saves are kept. Empty means
# data/ in the checkout (data/root.py). The container sets it to /app/data.
CRUX_DATA=
